NEXT_PUBLIC_TADAPO_SITE_URL=https://tadapo.com
NEXT_PUBLIC_TADAPO_INDEXABLE=false
# Adresse surveillée et expéditeur sur un domaine vérifié dans le compte Resend actuel.
TADAPO_CONTACT_EMAIL=
TADAPO_FROM_EMAIL=
RESEND_API_KEY=
# Compte PostgreSQL dédié, restreint selon scripts/tadapo-permissions.ts.
DATABASE_URL=
DATABASE_POOL_MAX=3
# Même clé d’encryption que l’admin et le worker (32 octets encodés en base64).
COMMERCIAL_ENCRYPTION_KEY=
# Même compte Stripe que Zelyweb. Tester avec sk_test_ avant toute activation réelle.
STRIPE_SECRET_KEY=
# Bloque les nouvelles commandes réelles ; ne bloque pas les abonnements déjà souscrits.
TADAPO_ORDERING_ENABLED=false
# Protection partagée de production. L’absence de configuration ferme les routes publiques.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Facultatif : seulement si Railway garantit que ce header est remplacé par sa passerelle.
# Sans ce réglage, la limite est globale, pas fondée sur un header client non fiable.
TADAPO_TRUSTED_IP_HEADER=
# GOOGLE_SITE_VERIFICATION=
