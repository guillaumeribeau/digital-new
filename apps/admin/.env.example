# Use the private PostgreSQL URL inside the same Railway project/environment.
# Runtime admin login must have separate privileges from website and worker.
DATABASE_URL=
DATABASE_POOL_MAX=3
DATABASE_SSL_CA=
# Operator-only migration/bootstrap connection; do not set on the running admin service.
DIRECT_URL=
# Exact admin origin. HTTPS required in production; no invented final domain.
BETTER_AUTH_URL=
# At least 32 random characters. Keep stable across admin instances and backups.
BETTER_AUTH_SECRET=
# Stable base64 AES key shared across instances for Next.js Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Only if guaranteed to be overwritten by the trusted Railway proxy.
# If unset, conservative global PostgreSQL authentication quota applies.
TRUSTED_CLIENT_IP_HEADER=

# Client communication / quotes. Use the admin origin for the client quote portal.
COMMERCIAL_PUBLIC_URL=
# local only on loopback development: no real email or bank payment.
COMMERCIAL_MODE=
# 32 bytes in base64, shared with the email worker; preserve on backups.
COMMERCIAL_ENCRYPTION_KEY=
COMMERCIAL_FROM_EMAIL=
# Resend receiving subdomain (e.g. reponses.your-domain.fr or your-id.resend.app).
COMMERCIAL_REPLY_DOMAIN=
RESEND_API_KEY=
# Clé autorisée à lire les e-mails entrants et pièces jointes. La clé d’envoi reste sur le worker.
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
# Zelyweb: existing merchant account.
ZELYWEB_STRIPE_SECRET_KEY=
ZELYWEB_STRIPE_WEBHOOK_SECRET=
# Tadapo: separate merchant account; no fallback to Zelyweb credentials.
TADAPO_STRIPE_SECRET_KEY=
TADAPO_STRIPE_WEBHOOK_SECRET=

# Tadapo: separate Stripe account and branded Resend sender.
NEXT_PUBLIC_TADAPO_SITE_URL=https://tadapo.com
TADAPO_CONTACT_EMAIL=contact@tadapo.com
TADAPO_FROM_EMAIL=
# Optional branded Resend receiving subdomain; empty means direct replies.
TADAPO_REPLY_DOMAIN=
# L’activation réelle des commandes sera validée séparément.
TADAPO_ORDERING_ENABLED=false

# Server-only Google Analytics Data API (read-only service account).
GA4_PROPERTY_ID=559264383
GA4_SERVICE_ACCOUNT_EMAIL=
# Preserve PEM newlines, or use literal \n in the Railway variable.
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
