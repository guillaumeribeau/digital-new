NEXT_PUBLIC_SITE_URL=
# Public Turnstile site key and private server secret from your Cloudflare widget.
# Loopback development uses official dummy keys when both are unset.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DATABASE_URL=
# Optional dedicated outbox worker login; if unset the worker uses DATABASE_URL.
WORKER_DATABASE_URL=
# Only for migration access when DATABASE_URL points to a pooler.
# Prisma 7 reads this variable through prisma.config.ts, not schema.prisma.
DIRECT_URL=
DATABASE_POOL_MAX=3
# Optional PEM CA (escaped newlines accepted). Omit sslmode in URL when providing a CA.
DATABASE_SSL_CA=
# 32 random bytes in base64; keep the same key on web and outbox worker.
OUTBOX_ENCRYPTION_KEY=
RESEND_API_KEY=
# Local browser mailbox, development + localhost only. Keep the preview token private.
LEAD_EMAIL_MODE=
LOCAL_EMAIL_PREVIEW_TOKEN=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
# Required in production: shared rate limiting via an Upstash-compatible Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Set ONLY if your hosting proxy overwrites this header on every request.
# Vercel is handled automatically. Otherwise an unset header uses a global quota.
TRUSTED_CLIENT_IP_HEADER=
# Commercial email worker: same mode, URL, sender/domain and encryption key as admin.
COMMERCIAL_MODE=
COMMERCIAL_PUBLIC_URL=
COMMERCIAL_ENCRYPTION_KEY=
COMMERCIAL_FROM_EMAIL=
COMMERCIAL_REPLY_DOMAIN=
# Optional consent-gated Google Tag Manager container
NEXT_PUBLIC_GTM_ID=
