NEXT_PUBLIC_SITE_URL=
# Root example retained for operator/legacy CLI configuration.
# Application examples: apps/website/.env.example and apps/admin/.env.example.
DATABASE_URL=
# Only for migration access when DATABASE_URL points to a pooler.
# Prisma 7 reads this variable through prisma.config.ts, not schema.prisma.
DIRECT_URL=
DATABASE_POOL_MAX=3
# Optional PEM CA (escaped newlines accepted). Omit sslmode in URL when providing a CA.
DATABASE_SSL_CA=
# 32 random bytes in base64; keep the same key on web and outbox worker.
OUTBOX_ENCRYPTION_KEY=
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
# Required in production: shared rate limiting via an Upstash-compatible Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Set ONLY if your hosting proxy overwrites this header on every request.
# Vercel is handled automatically. Otherwise an unset header uses a global quota.
TRUSTED_CLIENT_IP_HEADER=
# Optional consent-gated Google Tag Manager container
NEXT_PUBLIC_GTM_ID=
